# Copia questo file in .env e compila i valori (vedi README)
PORT=3000
AZIENDA_NOME=Industrie Fracchiolla - Divisione Impianti
AZIENDA_TELEFONO=+39 000 0000000

# Password del pannello /admin (obbligatoria, scegline una lunga)
